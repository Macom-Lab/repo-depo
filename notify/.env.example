# Generate a unique value with at least 32 random bytes, for example:
# openssl rand -hex 32
SERVICE_KEY=replace-with-a-unique-random-secret-at-least-32-bytes

# Production defaults only permit HTTPS destinations on TCP 443. Restricting
# this to the exact expected receiver hostnames is strongly recommended.
WEBHOOK_HOST_ALLOWLIST=hooks.example.com
WEBHOOK_ALLOWED_PORTS=443
ALLOW_INSECURE_WEBHOOKS=false
